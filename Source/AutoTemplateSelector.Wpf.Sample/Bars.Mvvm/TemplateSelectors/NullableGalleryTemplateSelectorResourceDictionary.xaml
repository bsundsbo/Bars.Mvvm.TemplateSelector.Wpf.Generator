<!--
    x:Class is required to wire up the code-behind file for this resource dictionary.
    The name of the class matches that of the parameter to the AutoTemplateSelectorAttribute.
-->
<ResourceDictionary x:Class="Bars.Mvvm.FluidGenerator.Sample.NullableGalleryTemplateSelectorResourceDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sample="clr-namespace:Bars.Mvvm.FluidGenerator.Sample">
    <!--
        The x:Key refers to a generated static class with a ResourceKeys suffix that starts with the same
        name as the attributed TemplateSelector.
    -->
    <DataTemplate x:Key="{x:Static sample:NullableGalleryTemplateSelectorResourceKeys.ReferenceCodeMenuItemTemplate}"
                  DataType="{x:Type sample:ReferenceCodeGalleryItemViewModel}">
        <DockPanel>
            <Grid DockPanel.Dock="Left">
                <Rectangle Fill="Red"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch" />
                <TextBlock Margin="10" Text="{Binding Path=Value.Code}" />
            </Grid>
            <TextBlock Margin="10,2,2,10" Text="{Binding Path=Value.Name}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="x:Static sample:NullableGalleryTemplateSelectorResourceKeys.ReferenceCodeTemplate}"
                  DataType="{x:Type sample:ReferenceCodeGalleryItemViewModel}">
        <DockPanel>
            <Grid DockPanel.Dock="Left">
                <Rectangle Fill="Red"
                           Height="40"
                           Width="40"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch" />
                <TextBlock Margin="10" Text="{Binding Path=Value.Code}" />
            </Grid>
            <TextBlock Margin="10,2,2,10" Text="{Binding Path=Value.Name}" />
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>