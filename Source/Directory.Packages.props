<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ActiproWpfVersion>25.1.1</ActiproWpfVersion>
  </PropertyGroup>
  <!-- Global references -->
  <ItemGroup>
    <PackageVersion Include="JetBrains.Annotations" Version="2024.3.0" PrivateAssets="all" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.19.0.132793" />
  </ItemGroup>
  <!-- Sample application references -->
  <ItemGroup>
    <PackageVersion Include="ActiproSoftware.Controls.WPF" Version="$(ActiproWpfVersion)" />
    <PackageVersion Include="ActiproSoftware.Controls.WPF.Bars" Version="$(ActiproWpfVersion)" />
    <PackageVersion Include="ActiproSoftware.Controls.WPF.Bars.Mvvm" Version="$(ActiproWpfVersion)" />
    <PackageVersion Include="ActiproSoftware.Controls.WPF.Shared" Version="$(ActiproWpfVersion)" />
    <PackageVersion Include="ActiproSoftware.Controls.Avalonia.Bars.Mvvm" Version="25.1.0" />
    <PackageVersion Include="Bars.Mvvm.FluentApi.Generator" Version="0.3.0" />
    <PackageVersion Include="MahApps.Metro.IconPacks.Material" Version="6.1.0" />
  </ItemGroup>
  <!-- Source generation and build references -->
  <ItemGroup>
    <PackageVersion Include="Nuke.Common" Version="9.0.4" />
    <PackageVersion Include="Scriban" Version="6.2.1" IncludeAssets="Build" />
  </ItemGroup>
  <!-- Analyzer references -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>
  <!-- Analyzer test references -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Testing" Version="1.1.3" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.3" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" PrivateAssets="all" />
  </ItemGroup>
</Project>